# ==============================================================================
# Vending SaaS - Production Environment Configuration
# ==============================================================================

# PostgreSQL Database
# All values below are REQUIRED — server.ts, client.ts, and docker-compose.yml
# throw a fatal error / refuse to start a service if any are missing. Never
# reuse the values shown here; generate your own (e.g. `openssl rand -hex 32`).
POSTGRES_USER=vending_user
POSTGRES_PASSWORD=<generate-a-unique-high-entropy-value>
POSTGRES_DB=vending_db
DATABASE_URL=postgresql://vending_user:<same-value-as-POSTGRES_PASSWORD>@db:5432/vending_db

# Fastify Backend API
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
JWT_SECRET=<generate-a-unique-high-entropy-value>
LOG_LEVEL=info

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=/api/v1

# Optional: enables the address autocomplete + Eircode auto-fill on the
# store registration form (Places + Geocoding APIs must be enabled on the
# key). Without it, the Eircode field just stays a plain manual text input.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Super Admin Bootstrap (packages/database/src/seed.ts — db:seed)
# Provisions/updates the single initial ADMIN account. All subsequent users
# are created via the in-app admin UI (POST /api/v1/users), not this script.
SUPER_ADMIN_EMAIL=admin@your-tenant.example
SUPER_ADMIN_PASSWORD=<generate-a-unique-strong-password>

# Optional: automated database backups to Google Drive (apps/api/src/core/backup).
# Without GOOGLE_SERVICE_ACCOUNT_JSON set, both scheduled jobs are skipped
# entirely — nothing else in the app depends on this.
# - Weekly raw pg_dump -> GDRIVE_BACKUP_FOLDER_ID, 3-week rolling retention.
# - Monthly CSV export (collections/machines/stores) -> GDRIVE_BACKUP_FOLDER_ID_CSV, 1-year retention.
# The service account must have edit access to both target Drive folders.
GOOGLE_SERVICE_ACCOUNT_JSON=<paste the service-account JSON key, or base64-encode it>
GDRIVE_BACKUP_FOLDER_ID=<Drive folder ID for weekly raw .sql dumps>
GDRIVE_BACKUP_FOLDER_ID_CSV=<Drive folder ID for monthly CSV exports>
