{
  "name": "bee-novelty",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Multi-Tenant Vending Machine SaaS Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @vending/api --filter @vending/web run dev",
    "dev:api": "pnpm --filter @vending/api run dev",
    "dev:web": "pnpm --filter @vending/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "vending",
    "saas",
    "multi-tenant"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.1.7",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6"
  }
}
