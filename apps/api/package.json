{
  "name": "@vending/api",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Backend API for Vending SaaS Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@vending/database": "workspace:*",
    "@vending/shared-types": "workspace:*",
    "@vending/validation": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "vending",
    "fastify",
    "api",
    "saas"
