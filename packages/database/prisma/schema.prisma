generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  FIELD_AGENT
}

enum MachineStatus {
  ONLINE
  OFFLINE
}

enum EntryType {
  STANDARD
  MANUAL
  REVERSE
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  themeConfig Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  machines      Machine[]
  locations     Location[]
  stores        Store[]
  packetConfigs PacketConfig[]
  inventoryLogs InventoryLog[]
  cashLogs      CashLog[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  role         UserRole @default(FIELD_AGENT)
  email        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]
  cashLogs      CashLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Machine {
  id                 String        @id @default(uuid())
  tenantId           String
  storeId            String?
  serialNumber       String
  location           String
  category           String?       @default("Standard Confectionery")
  type               String?       @default("Spiral Chute")
  capacity           Int?          @default(100)
  status             MachineStatus @default(ONLINE)
  qrCode             String
  virtualCashBalance Decimal       @default(0.0) @db.Decimal(10, 2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  inventoryLogs InventoryLog[]
  cashLogs      CashLog[]

  @@unique([tenantId, serialNumber])
  @@unique([tenantId, qrCode])
  @@index([tenantId])
  @@index([storeId])
  @@map("machines")
}

model PacketConfig {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  brand             String
  quantityPerPacket Int
  pricePerItem      Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLogs InventoryLog[]

  @@index([tenantId])
  @@map("packet_configs")
}

model InventoryLog {
  id            String    @id @default(uuid())
  tenantId      String
  machineId     String
  agentId       String
  packetId      String?
  entryType     EntryType @default(STANDARD)
  quantityAdded Int
  remarks       String
  createdAt     DateTime  @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  machine Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  agent   User          @relation(fields: [agentId], references: [id], onDelete: Restrict)
  packet  PacketConfig? @relation(fields: [packetId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([machineId])
  @@index([agentId])
  @@map("inventory_logs")
}

model CashLog {
  id              String   @id @default(uuid())
  tenantId        String
  machineId       String
  agentId         String
  collectedAmount Decimal  @db.Decimal(10, 2)
  expectedAmount  Decimal  @db.Decimal(10, 2)
  discrepancy     Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  agent   User    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([machineId])
  @@index([agentId])
  @@map("cash_logs")
}

model Location {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stores Store[]

  @@index([tenantId])
  @@map("locations")
}

model Store {
  id                 String   @id @default(uuid())
  tenantId           String
  locationId         String
  name               String
  category           String?  @default("Confectionery & Toys")
  shopCutPercent     Int      @default(30)
  businessCutPercent Int      @default(70)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  machines Machine[]

  @@index([tenantId])
  @@index([locationId])
  @@map("stores")
}

